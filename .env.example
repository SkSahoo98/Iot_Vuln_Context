# Copy this file to .env and fill in values for YOUR authorized lab only.
# Never commit the real .env file.

# Application
ENVIRONMENT=development
PROJECT_NAME=IoT Security Framework

# Database (PostgreSQL 18+ — Phase 4 Database)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/iot_security
POSTGRES_ADMIN_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres

# Explicit PostgreSQL settings used by the MQTT collector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iot_security
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# MQTT broker on the authorized lab network
MQTT_BROKER_HOST=10.32.252.85
MQTT_BROKER_PORT=1883
MQTT_TOPIC=iot/esp32/+/sensor
MQTT_CLIENT_ID=iot-security-mqtt-collector
MQTT_USERNAME=iot_collector
MQTT_PASSWORD=
MQTT_USE_TLS=false

# Evidence flags for findings/risk APIs (authorized lab only)
MQTT_TLS_ENABLED=false
MQTT_ANONYMOUS_ALLOWED=true
MQTT_SERVICE_NAME=mosquitto
MQTT_SERVICE_VERSION=2.1.2
MQTT_OBSERVED_TOPICS=iot/esp32/01/sensor,iot/esp32/02/sensor

# Default IoT context for GET /api/v1/risk
RISK_DEVICE_CRITICALITY=0.3
RISK_NETWORK_EXPOSURE=0.3
RISK_FIRMWARE_SECURITY=0.5

# Device ONLINE only while valid telemetry is newer than this window (seconds)
DEVICE_OFFLINE_AFTER_SECONDS=30

# Local Ollama AI explanation (optional; rule-based fallback if unavailable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180

# Collector connection pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# Scanner (authorized lab only — Phase 7+)
SCANNER_TIMEOUT=30
AUTHORIZED_LAB_CIDR=192.168.0.0/24
REQUIRE_AUTHORIZED_LAB=true

# Vulnerability intelligence (optional — Phase 10)
CVE_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CVE_API_KEY=

# API
API_HOST=127.0.0.1
API_PORT=8000
