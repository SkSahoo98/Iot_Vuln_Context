# Copy to project root `.env` or `backend/.env` and replace CHANGE_ME.
# Never commit a real .env file.
# Lab MQTT is plaintext on port 1883 — keep it off the public Internet.

# --- PostgreSQL (localhost; not the MQTT broker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iot_security
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Preferred SQLAlchemy URL (psycopg3)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/iot_security

# --- MQTT broker (set your lab IP in local .env) ---
MQTT_BROKER_HOST=10.32.252.85
MQTT_BROKER_PORT=1883
MQTT_TOPIC=iot/esp32/+/sensor
MQTT_CLIENT_ID=iot-security-mqtt-collector
MQTT_USERNAME=iot_collector
MQTT_PASSWORD=

# Evidence flags for findings/risk APIs (authorized lab only)
MQTT_TLS_ENABLED=false
MQTT_ANONYMOUS_ALLOWED=true
MQTT_SERVICE_NAME=mosquitto
MQTT_SERVICE_VERSION=2.1.2
MQTT_OBSERVED_TOPICS=iot/esp32/01/sensor,iot/esp32/02/sensor

# Default IoT context for GET /api/v1/risk
RISK_DEVICE_CRITICALITY=0.3
RISK_NETWORK_EXPOSURE=0.3
RISK_FIRMWARE_SECURITY=0.5

# Device ONLINE only while valid telemetry is newer than this window (seconds)
DEVICE_OFFLINE_AFTER_SECONDS=30

# --- Authorized active assessment (private lab IP literals only) ---
# Empty means every target is rejected. CIDR ranges and hostnames are refused.
ASSESSMENT_ALLOWED_TARGETS=127.0.0.1
ASSESSMENT_PORTS=21,22,23,25,53,80,110,139,443,445,554,1883,8080,8443,8883
ASSESSMENT_MAX_OPEN_SERVICES=5
ASSESSMENT_ADMIN_SERVICE_PORTS=22,139,445
ASSESSMENT_PROBE_TIMEOUT_SECONDS=5
NMAP_PATH=nmap
NMAP_TIMEOUT_SECONDS=180
MQTT_TLS_PORT=8883

# Local Ollama AI explanation (optional; rule-based fallback if unavailable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180

# --- Collector connection pool ---
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

API_HOST=127.0.0.1
API_PORT=8000
